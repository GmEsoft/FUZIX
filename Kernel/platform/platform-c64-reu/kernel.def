; UZI mnemonics for memory addresses etc

; (this is struct u_data from kernel.h)
; 256+256 bytes.
U_DATA__TOTALSIZE       .equ	0x200
PROGLOAD		.equ	0x4000

; Must be 512 byte sized and page aligned
REUSWITCH		.equ	0x3E00
REUSWITCHSIZE		.equ	0xC000

; Must match config.h
NBUFS			.equ	5

#define	CARTPORT	0xDE60

/*
 *	DE
 */

#define ROM0		0x01
#define ROM1		0x02
#define ROM2		0x03
#define ROM3		0x04
#define ROM4		0x05
